{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/features/control-room/shared/control-room-icon": ["./src/features/admin/shared/admin-icon"],
      "@/features/control-room/holds/*": ["./src/features/admin/holds/*"],
      "@/features/control-room/customers/*": ["./src/features/admin/customers/*"],
      "@/features/control-room/returns/*": ["./src/features/admin/returns/*"],
      "@/features/control-room/inventory/*": ["./src/features/admin/inventory/*"],
      "@/lib/control-room/*": ["./src/lib/admin/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}

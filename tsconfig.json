{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/features/control-room/shared/control-room-icon": ["./src/features/admin/shared/admin-icon"],
      "@/features/control-room/state/control-room-provider": ["./src/features/admin/state/admin-provider"],
      "@/features/control-room/state/control-room-store": ["./src/features/admin/state/admin-store"],
      "@/features/control-room/data/control-room-repository-context": ["./src/features/admin/data/admin-repository-context"],
      "@/features/control-room/orders/*": ["./src/features/admin/orders/*"],
      "@/features/control-room/holds/*": ["./src/features/admin/holds/*"],
      "@/features/control-room/customers/*": ["./src/features/admin/customers/*"],
      "@/features/control-room/returns/*": ["./src/features/admin/returns/*"],
      "@/features/control-room/settings/*": ["./src/features/admin/settings/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}

/// Exact customer-entered identity fields that must round-trip independently.
/// Supabase Auth metadata remains the identity-provider copy; this table is the
/// application-owned profile form source of truth.
model profile_details {
  profile_id     String   @id @db.Uuid
  first_name     String
  last_name      String
  preferred_name String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@schema("public")
}

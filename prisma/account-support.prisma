/// Customer support conversation header. Ownership is direct (customer_id);
/// a customer reply on a resolved/closed ticket reopens it at the command layer.
model support_tickets {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id     String                  @db.Uuid
  subject         String
  category        support_ticket_category @default(other)
  status          support_ticket_status   @default(open)
  last_message_at DateTime?               @db.Timestamptz(6)
  created_at      DateTime                @default(now()) @db.Timestamptz(6)
  updated_at      DateTime                @default(now()) @updatedAt @db.Timestamptz(6)

  customers        customers          @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  support_messages support_messages[]

  @@index([customer_id, created_at(sort: Desc)], map: "support_tickets_customer_created_idx")
  @@index([status, updated_at(sort: Desc)], map: "support_tickets_status_updated_idx")
  @@schema("public")
}

/// Immutable message thread. Ownership is derived through support_tickets, so
/// a message cannot describe a ticket outside its own thread.
model support_messages {
  id                String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id         String                      @db.Uuid
  author_kind       support_message_author_kind
  author_profile_id String?                     @db.Uuid
  body              String
  created_at        DateTime                    @default(now()) @db.Timestamptz(6)

  support_tickets     support_tickets       @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  author_profile      profiles?             @relation(fields: [author_profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  support_attachments support_attachments[]

  @@index([ticket_id, created_at(sort: Asc)], map: "support_messages_ticket_created_idx")
  @@schema("public")
}

/// Attachment metadata only. The referenced Cloudinary asset must already be a
/// completed, customer-owned signed upload before it can be attached.
model support_attachments {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message_id String   @db.Uuid
  asset_id   String   @db.Uuid
  file_name  String
  mime_type  String
  size_bytes Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  support_messages  support_messages  @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cloudinary_assets cloudinary_assets @relation(fields: [asset_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([message_id], map: "support_attachments_message_idx")
  @@schema("public")
}

enum support_ticket_category {
  order
  payment
  product
  account
  other

  @@schema("public")
}

enum support_ticket_status {
  open
  pending_customer
  pending_staff
  resolved
  closed

  @@schema("public")
}

enum support_message_author_kind {
  customer
  staff

  @@schema("public")
}

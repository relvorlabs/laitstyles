generator client {
  provider        = "prisma-client-js"
  output          = "./generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

/// IMPORTANT: Prisma manages the public schema only. The companion
/// laitstyles-auth-and-integrity.sql migration adds the foreign key from
/// profiles.id to auth.users.id and cross-record business invariants that
/// Prisma schema syntax cannot express cleanly.

/// Human-readable store activity for dashboards and operational feeds.
model activity_events {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind             String
  title            String
  detail           String?
  actor_profile_id String?  @db.Uuid
  product_id       String?  @db.Uuid
  order_id         String?  @db.Uuid
  customer_id      String?  @db.Uuid
  occurred_at      DateTime @default(now()) @db.Timestamptz(6)

  profiles  profiles?  @relation(fields: [actor_profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  customers customers? @relation(fields: [customer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  orders    orders?    @relation(fields: [order_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  products  products?  @relation(fields: [product_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([occurred_at(sort: Desc)], map: "activity_events_store_occurred_idx")
  @@index([product_id, occurred_at(sort: Desc)], map: "activity_events_product_occurred_idx")
  @@index([order_id, occurred_at(sort: Desc)], map: "activity_events_order_occurred_idx")
  @@schema("public")
}

/// Security and administrative audit trail.
model audit_events {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_profile_id String?  @db.Uuid
  action           String
  target_table     String?
  target_id        String?  @db.Uuid
  metadata         Json     @default("{}")
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  profiles profiles? @relation(fields: [actor_profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "audit_events_store_created_idx")
  @@index([target_table, target_id], map: "audit_events_target_idx")
  @@schema("public")
}

model catalogue_categories {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  slug       String
  image_url  String?
  position   Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  products products[]

  @@unique([slug])
  @@index([position])
  @@schema("public")
}

model catalogue_collections {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  slug       String
  position   Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  products products[]

  @@unique([slug])
  @@index([position])
  @@schema("public")
}

model cloudinary_assets {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider              String                @default("cloudinary")
  resource_type         String                @default("image")
  kind                  cloudinary_asset_kind
  public_id             String
  secure_url            String
  delivery_url          String?
  format                String?
  version               BigInt?
  width                 Int?
  height                Int?
  bytes                 Int?
  alt                   String                @default("")
  created_by_profile_id String?               @db.Uuid
  created_at            DateTime              @default(now()) @db.Timestamptz(6)

  profiles            profiles?             @relation(fields: [created_by_profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  product_media       product_media[]
  store_brand_assets  store_brand_assets[]
  support_attachments support_attachments[]

  @@unique([public_id])
  @@index([kind], map: "cloudinary_assets_store_kind_idx")
  @@schema("public")
}

model customer_addresses {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id    String   @db.Uuid
  label          String?
  line1          String
  line2          String?
  city           String
  state          String?
  country        String   @default("Nigeria")
  is_default     Boolean  @default(false)
  delivery_notes String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  customers customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([customer_id], map: "customer_addresses_one_default_unique", where: { is_default: true })
  @@index([customer_id])
  @@schema("public")
}

model customer_notes {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id       String   @db.Uuid
  body              String
  author_profile_id String?  @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  profiles  profiles? @relation(fields: [author_profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  customers customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customer_id], map: "customer_notes_store_customer_idx")
  @@schema("public")
}

model customer_saved_products {
  customer_id String   @db.Uuid
  product_id  String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  customers customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products  products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([customer_id, product_id])
  @@schema("public")
}

model customers {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id String?  @unique(map: "customers_profile_unique") @db.Uuid
  name       String
  email      String?
  phone      String?
  city       String?
  type       String   @default("individual")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  activity_events           activity_events[]
  account_deletion_requests account_deletion_requests[]
  customer_addresses        customer_addresses[]
  customer_notes            customer_notes[]
  customer_preferences      customer_preferences?
  customer_saved_products   customer_saved_products[]
  data_export_jobs          data_export_jobs[]
  notification_preferences  notification_preferences[]
  notifications             notifications[]
  privacy_consents          privacy_consents[]
  profile                   profiles?                   @relation(fields: [profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  holds                     holds[]
  orders                    orders[]
  support_tickets           support_tickets[]

  /// One authenticated profile may own at most one commerce customer record.
  /// Guest/CRM customers may have profile_id = NULL.
  @@index([email], map: "customers_store_email_idx")
  @@schema("public")
}

model delivery_zones {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  city           String
  rate           Decimal  @default(0) @db.Decimal(12, 2)
  estimated_days String?
  enabled        Boolean  @default(true)
  position       Int      @default(0)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  orders orders[]

  @@index([enabled, position])
  @@index([city, enabled])
  @@schema("public")
}

/// One delivery execution record per order. The selected courier snapshot may
/// still live on orders.courier; this model tracks operational API dispatch.
model deliveries {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id           String          @unique @db.Uuid
  provider           String?
  service_code       String?
  status             delivery_status @default(pending)
  provider_reference String?
  request_payload    Json?
  provider_response  Json?
  attempts           Int             @default(0)
  last_error         String?
  requested_at       DateTime?       @db.Timestamptz(6)
  accepted_at        DateTime?       @db.Timestamptz(6)
  dispatched_at      DateTime?       @db.Timestamptz(6)
  delivered_at       DateTime?       @db.Timestamptz(6)
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime        @default(now()) @updatedAt @db.Timestamptz(6)

  orders orders @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, updated_at], map: "deliveries_status_updated_idx")
  @@index([provider_reference], map: "deliveries_provider_reference_idx")
  @@schema("public")
}

/// Stock reservations over the same catalogue products. A hold can be attached
/// to an order before payment so settlement can atomically convert it to sold.
model holds {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id      String                @db.Uuid
  product_id       String                @db.Uuid
  variant_id       String?               @db.Uuid
  order_id         String?               @db.Uuid
  quantity         Int
  stage            hold_stage            @default(product)
  source           String
  payment_progress hold_payment_progress @default(not_started)
  status           hold_status           @default(active)
  started_at       DateTime              @default(now()) @db.Timestamptz(6)
  expires_at       DateTime              @db.Timestamptz(6)
  released_at      DateTime?             @db.Timestamptz(6)
  converted_at     DateTime?             @db.Timestamptz(6)
  note             String?

  customers        customers         @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products         products          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  orders           orders?           @relation("order_holds", fields: [order_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  stock_movements  stock_movements[] @relation("stock_movement_hold")

  @@index([customer_id, status], map: "holds_customer_status_idx")
  @@index([order_id, status], map: "holds_order_status_idx")
  @@index([status, expires_at], map: "holds_store_status_expires_idx")
  @@index([product_id, variant_id, status], map: "holds_stock_target_status_idx")
  @@schema("public")
}

/// Operational intake/grading workflow for catalogue products. Inventory views
/// should join this model with products, stock_levels, holds and stock_movements.
model intake_records {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id           String       @db.Uuid
  stage                intake_stage @default(received)
  assigned_profile_id  String?      @db.Uuid
  graded_by_profile_id String?      @db.Uuid
  grade                String?
  blocking_reasons     Json         @default("[]")
  ready_for_listing    Boolean      @default(false)
  graded_at            DateTime?    @db.Timestamptz(6)
  completed_at         DateTime?    @db.Timestamptz(6)
  created_at           DateTime     @default(now()) @db.Timestamptz(6)
  updated_at           DateTime     @default(now()) @updatedAt @db.Timestamptz(6)

  assigned_profile  profiles? @relation("intake_assignee", fields: [assigned_profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  graded_by_profile profiles? @relation("intake_grader", fields: [graded_by_profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  products          products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([product_id])
  @@index([stage, created_at], map: "intake_records_stage_created_idx")
  @@index([assigned_profile_id, stage], map: "intake_records_assignee_stage_idx")
  @@index([ready_for_listing, updated_at], map: "intake_records_readiness_idx")
  @@schema("public")
}

model order_lines {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id   String  @db.Uuid
  product_id String  @db.Uuid
  variant_id String? @db.Uuid

  /// Purchase-time snapshots. They remain correct if catalogue copy changes.
  product_name  String
  variant_label String?
  sku           String?

  quantity           Int
  unit_price         Decimal                      @db.Decimal(12, 2)
  stock_state        order_line_stock_state       @default(uncommitted)
  fulfilment_status  order_line_fulfilment_status @default(unfulfilled)
  delivered_quantity Int                          @default(0)
  delivered_at       DateTime?                    @db.Timestamptz(6)
  cancelled_quantity Int                          @default(0)
  refund_status      order_line_refund_status     @default(not_refunded)
  refunded_amount    Decimal                      @default(0) @db.Decimal(12, 2)
  refunded_at        DateTime?                    @db.Timestamptz(6)

  orders           orders            @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products         products          @relation(fields: [product_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product_review   product_reviews?
  return_lines     return_lines[]

  @@index([order_id])
  @@index([product_id])
  @@index([variant_id], where: raw("(variant_id IS NOT NULL)"))
  @@schema("public")
}

/// Append-only payment history. The payments table stores current transaction
/// facts; this table records meaningful changes and operator actions.
model order_payment_events {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id         String                  @db.Uuid
  payment_id       String?                 @db.Uuid
  kind             payment_event_kind
  status           payment_attempt_status?
  amount           Decimal                 @default(0) @db.Decimal(12, 2)
  currency         String                  @default("NGN") @db.VarChar(3)
  method           String?
  occurred_at      DateTime                @default(now()) @db.Timestamptz(6)
  actor_profile_id String?                 @db.Uuid
  note             String?
  metadata         Json                    @default("{}")

  profiles profiles? @relation(fields: [actor_profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  orders   orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payments payments? @relation(fields: [payment_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([order_id, occurred_at(sort: Desc)], map: "order_payment_events_order_occurred_idx")
  @@index([payment_id, occurred_at(sort: Desc)], map: "order_payment_events_payment_occurred_idx")
  @@schema("public")
}

/// One overall review per completed order. The author/customer is derived from
/// order -> customer, while moderation is performed by a manager or admin.
model order_reviews {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id               String        @unique @db.Uuid
  overall_rating         Int
  delivery_rating        Int?
  packaging_rating       Int?
  service_rating         Int?
  title                  String?
  body                   String?
  status                 review_status @default(pending)
  reviewed_by_profile_id String?       @db.Uuid
  reviewed_at            DateTime?     @db.Timestamptz(6)
  rejection_reason       String?
  created_at             DateTime      @default(now()) @db.Timestamptz(6)
  updated_at             DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  order               orders    @relation(fields: [order_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reviewed_by_profile profiles? @relation("order_review_moderator", fields: [reviewed_by_profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([status, created_at(sort: Desc)], map: "order_reviews_status_created_idx")
  @@index([reviewed_by_profile_id], map: "order_reviews_moderator_idx")
  @@schema("public")
}

model order_timeline_events {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id         String   @db.Uuid
  status           String
  occurred_at      DateTime @default(now()) @db.Timestamptz(6)
  actor_profile_id String?  @db.Uuid
  note             String?
  metadata         Json     @default("{}")

  profiles profiles? @relation(fields: [actor_profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  orders   orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id, occurred_at(sort: Desc)], map: "order_timeline_events_order_occurred_idx")
  @@schema("public")
}

model orders {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_number String  @unique(map: "orders_order_number_unique")
  customer_id  String  @db.Uuid
  source       String
  channel      String?

  /// Aggregate order state, not the status of one Paystack attempt.
  payment_status    order_payment_status @default(pending)
  payment_method    String?
  fulfilment_method fulfilment_method    @default(delivery)
  fulfilment_status fulfilment_status    @default(unfulfilled)

  delivery_zone_id   String? @db.Uuid
  pickup_location_id String? @db.Uuid

  /// Checkout-time snapshots remain stable after customer/address edits.
  customer_name    String?
  customer_email   String?
  delivery_name    String?
  delivery_phone   String?
  delivery_city    String?
  delivery_address Json?
  courier          Json?

  currency        String  @default("NGN") @db.VarChar(3)
  subtotal        Decimal @default(0) @db.Decimal(12, 2)
  delivery_fee    Decimal @default(0) @db.Decimal(12, 2)
  discount_amount Decimal @default(0) @db.Decimal(12, 2)
  total           Decimal @db.Decimal(12, 2)
  refunded_amount Decimal @default(0) @db.Decimal(12, 2)

  placed_at             DateTime  @default(now()) @db.Timestamptz(6)
  paid_at               DateTime? @db.Timestamptz(6)
  notes                 String?
  attention             String?
  created_by_profile_id String?   @db.Uuid
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  updated_at            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  activity_events       activity_events[]
  customer              customers               @relation(fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  created_by_profile    profiles?               @relation(fields: [created_by_profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  delivery              deliveries?
  delivery_zone         delivery_zones?         @relation(fields: [delivery_zone_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  holds                 holds[]                 @relation("order_holds")
  order_lines           order_lines[]
  order_payment_events  order_payment_events[]
  order_review          order_reviews?
  order_timeline_events order_timeline_events[]
  payments              payments[]
  pickup_location       pickup_locations?       @relation(fields: [pickup_location_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  returns               returns[]
  stock_movements       stock_movements[]       @relation("stock_movement_order")

  @@index([customer_id, placed_at(sort: Desc)], map: "orders_customer_placed_idx")
  @@index([placed_at(sort: Desc)], map: "orders_store_placed_idx")
  @@index([payment_status, placed_at(sort: Desc)], map: "orders_payment_status_placed_idx")
  @@index([fulfilment_status, placed_at(sort: Desc)], map: "orders_fulfilment_status_placed_idx")
  @@index([delivery_zone_id], map: "orders_delivery_zone_idx")
  @@index([pickup_location_id], map: "orders_pickup_location_idx")
  @@schema("public")
}

/// One row per payment attempt. Paystack browser verification and the signed
/// webhook both settle through this same transaction record.
model payments {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id                String                 @db.Uuid
  provider                payment_provider       @default(paystack)
  reference               String                 @unique
  access_code             String?
  amount                  Decimal                @db.Decimal(12, 2)
  currency                String                 @default("NGN") @db.VarChar(3)
  status                  payment_attempt_status @default(initializing)
  provider_transaction_id String?
  channel                 String?
  gateway_response        String?
  raw_response            Json?
  paid_at                 DateTime?              @db.Timestamptz(6)
  created_at              DateTime               @default(now()) @db.Timestamptz(6)
  updated_at              DateTime               @default(now()) @updatedAt @db.Timestamptz(6)

  orders               orders                 @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order_payment_events order_payment_events[]

  @@unique([provider, provider_transaction_id], map: "payments_provider_transaction_unique", where: raw("(provider_transaction_id IS NOT NULL)"))
  @@index([order_id, created_at(sort: Desc)], map: "payments_order_created_idx")
  @@index([status, updated_at], map: "payments_status_updated_idx")
  @@schema("public")
}

model pickup_locations {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  address    String
  enabled    Boolean  @default(true)
  position   Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  orders orders[]

  @@index([enabled, position])
  @@schema("public")
}

model product_channels {
  product_id String          @db.Uuid
  channel    product_channel
  created_at DateTime        @default(now()) @db.Timestamptz(6)

  products products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([product_id, channel])
  @@index([channel])
  @@schema("public")
}

model product_measurements {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String @db.Uuid
  label      String
  value      String
  position   Int    @default(0)

  products products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([product_id, position])
  @@schema("public")
}

model product_media {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String                @db.Uuid
  variant_id String?               @db.Uuid
  asset_id   String                @db.Uuid
  kind       cloudinary_asset_kind
  position   Int                   @default(0)
  created_at DateTime              @default(now()) @db.Timestamptz(6)

  cloudinary_assets cloudinary_assets @relation(fields: [asset_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  products          products          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants  product_variants? @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([product_id, position], map: "product_media_product_position_unique", where: raw("(variant_id IS NULL)"))
  @@unique([product_id, variant_id, position], map: "product_media_variant_position_unique", where: raw("(variant_id IS NOT NULL)"))
  @@index([product_id, position], map: "product_media_product_position_idx")
  @@schema("public")
}

/// A verified-purchase product review. Product and customer are derived through
/// order_line -> order/product, preventing reviews for an unrelated listing.
model product_reviews {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_line_id          String        @unique @db.Uuid
  rating                 Int
  title                  String?
  body                   String?
  fit                    review_fit?
  size_ordered           String?
  status                 review_status @default(pending)
  submitted_at           DateTime      @default(now()) @db.Timestamptz(6)
  published_at           DateTime?     @db.Timestamptz(6)
  reviewed_by_profile_id String?       @db.Uuid
  reviewed_at            DateTime?     @db.Timestamptz(6)
  rejection_reason       String?
  created_at             DateTime      @default(now()) @db.Timestamptz(6)
  updated_at             DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  order_line          order_lines @relation(fields: [order_line_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reviewed_by_profile profiles?   @relation("product_review_moderator", fields: [reviewed_by_profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([status, created_at(sort: Desc)], map: "product_reviews_status_created_idx")
  @@index([reviewed_by_profile_id], map: "product_reviews_moderator_idx")
  @@schema("public")
}

model product_variants {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String   @db.Uuid
  label      String
  sku        String?
  size       String?
  colour     String?
  price      Decimal? @db.Decimal(12, 2)
  cost       Decimal? @db.Decimal(12, 2)
  position   Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  holds           holds[]
  order_lines     order_lines[]
  product_media   product_media[]
  products        products          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stock_levels    stock_levels[]
  stock_movements stock_movements[]

  @@unique([product_id, sku], map: "product_variants_product_sku_unique", where: raw("(sku IS NOT NULL)"))
  @@index([product_id, position])
  @@schema("public")
}

/// Canonical catalogue record. Inventory is the operational view formed by
/// this same product plus intake_records, stock_levels, holds and movements.
///
/// inventory_mode semantics:
/// - unique: one-of-one piece; physical quantity must never exceed 1.
/// - stocked: many identical units tracked at product level.
/// - variant: quantities are tracked per product_variants row.
model products {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id           String?                @db.Uuid
  collection_id         String?                @db.Uuid
  slug                  String
  name                  String
  description           String                 @default("")
  inventory_mode        product_inventory_mode
  brand                 String?
  price                 Decimal                @db.Decimal(12, 2)
  reference_price       Decimal?               @db.Decimal(12, 2)
  cost                  Decimal?               @db.Decimal(12, 2)
  lifecycle             product_lifecycle      @default(draft)
  publication           product_publication    @default(unpublished)
  low_stock_threshold   Int                    @default(1)
  archive_number        String?
  sku                   String?
  condition             String?
  size_label            String?
  colour                String?
  material              String?
  fit                   String?
  style                 String?
  care_instructions     String?
  flaw_notes            String?
  weight_grams          Int?
  pickup_available      Boolean                @default(true)
  delivery_restrictions String                 @default("")
  packaging_notes       String                 @default("")
  scheduled_at          DateTime?              @db.Timestamptz(6)
  published_at          DateTime?              @db.Timestamptz(6)
  created_at            DateTime               @default(now()) @db.Timestamptz(6)
  updated_at            DateTime               @default(now()) @updatedAt @db.Timestamptz(6)

  activity_events         activity_events[]
  customer_saved_products customer_saved_products[]
  holds                   holds[]
  intake_record           intake_records?
  order_lines             order_lines[]
  product_channels        product_channels[]
  product_measurements    product_measurements[]
  product_media           product_media[]
  product_variants        product_variants[]
  catalogue_categories    catalogue_categories?     @relation(fields: [category_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  catalogue_collections   catalogue_collections?    @relation(fields: [collection_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  stock_levels            stock_levels[]
  stock_movements         stock_movements[]

  @@unique([archive_number], map: "products_store_archive_number_unique", where: raw("(archive_number IS NOT NULL)"))
  @@unique([slug])
  @@unique([sku], map: "products_store_sku_unique", where: raw("(sku IS NOT NULL)"))
  @@index([inventory_mode], map: "products_store_inventory_mode_idx")
  @@index([lifecycle, publication], map: "products_store_lifecycle_publication_idx")
  @@index([publication, published_at(sort: Desc)], map: "products_publication_published_idx")
  @@index([created_at(sort: Asc)], map: "products_age_idx")
  @@schema("public")
}

/// Application account/profile. The id is the same UUID as Supabase
/// auth.users.id; credentials and provider identities remain in Supabase Auth.
/// Consumers may have one customers row. Managers/admins do not need one.
//

model profiles {
  id                          String         @id @db.Uuid
  email                       String?
  role                        account_role   @default(consumer)
  status                      account_status @default(active)
  display_name                String?
  phone                       String?
  avatar_cloudinary_public_id String?
  avatar_url                  String?
  last_seen_at                DateTime?      @db.Timestamptz(6)
  created_at                  DateTime       @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime       @default(now()) @updatedAt @db.Timestamptz(6)

  activity_events           activity_events[]
  audit_events              audit_events[]
  cloudinary_assets         cloudinary_assets[]
  customer                  customers?
  customer_notes            customer_notes[]
  assigned_intake_records   intake_records[]        @relation("intake_assignee")
  graded_intake_records     intake_records[]        @relation("intake_grader")
  moderated_order_reviews   order_reviews[]         @relation("order_review_moderator")
  moderated_product_reviews product_reviews[]       @relation("product_review_moderator")
  order_payment_events      order_payment_events[]
  order_timeline_events     order_timeline_events[]
  orders                    orders[]
  stock_movements           stock_movements[]
  store_settings_updates    store_settings[]        @relation("store_settings_updater")
  support_messages          support_messages[]

  /// Multiple admins are allowed. Authorization must check both role and status.
  @@index([role, status], map: "profiles_role_status_idx")
  @@index([email], map: "profiles_email_idx")
  @@schema("public")
}

/// Product and variant are derived from order_line, preventing a return line
/// from describing a different item than the one originally purchased.
model return_lines {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  return_id     String                  @db.Uuid
  order_line_id String                  @db.Uuid
  quantity      Int
  disposition   return_line_disposition @default(pending)

  order_line order_lines @relation(fields: [order_line_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  return     returns     @relation(fields: [return_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([return_id, order_line_id], map: "return_lines_return_order_line_unique")
  @@index([order_line_id])
  @@schema("public")
}

/// Customer ownership is derived through order -> customer, so a return cannot
/// name a customer who does not own the order.
model returns {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id      String        @db.Uuid
  status        return_status @default(requested)
  reason        String?
  refund_amount Decimal       @default(0) @db.Decimal(12, 2)
  note          String?
  requested_at  DateTime      @default(now()) @db.Timestamptz(6)
  received_at   DateTime?     @db.Timestamptz(6)
  completed_at  DateTime?     @db.Timestamptz(6)
  updated_at    DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  return_lines    return_lines[]
  order           orders            @relation(fields: [order_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  stock_movements stock_movements[] @relation("stock_movement_return")

  @@index([status], map: "returns_store_status_idx")
  @@index([order_id, requested_at(sort: Desc)], map: "returns_order_requested_idx")
  @@schema("public")
}

/// Authoritative stock balances for the same products in the catalogue.
/// Partial unique indexes ensure one product-level row or one row per variant.
model stock_levels {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id     String   @db.Uuid
  variant_id     String?  @db.Uuid
  total_received Int      @default(0)
  available      Int      @default(0)
  reserved       Int      @default(0)
  committed      Int      @default(0)
  sold           Int      @default(0)
  returned       Int      @default(0)
  damaged        Int      @default(0)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  products         products          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([product_id], map: "stock_levels_product_unique", where: raw("(variant_id IS NULL)"))
  @@unique([product_id, variant_id], map: "stock_levels_variant_unique", where: raw("(variant_id IS NOT NULL)"))
  @@index([available], map: "stock_levels_store_available_idx")
  @@index([reserved], map: "stock_levels_store_reserved_idx")
  @@index([committed], map: "stock_levels_store_committed_idx")
  @@schema("public")
}

/// Immutable inventory ledger entries. stock_levels is the current balance;
/// stock_movements explains how that balance changed.
model stock_movements {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id        String              @db.Uuid
  variant_id        String?             @db.Uuid
  kind              stock_movement_kind
  quantity          Int
  occurred_at       DateTime            @default(now()) @db.Timestamptz(6)
  actor_profile_id  String?             @db.Uuid
  note              String?
  related_order_id  String?             @db.Uuid
  related_hold_id   String?             @db.Uuid
  related_return_id String?             @db.Uuid
  metadata          Json                @default("{}")

  profiles         profiles?         @relation(fields: [actor_profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  products         products          @relation(fields: [product_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  related_order    orders?           @relation("stock_movement_order", fields: [related_order_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  related_hold     holds?            @relation("stock_movement_hold", fields: [related_hold_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  related_return   returns?          @relation("stock_movement_return", fields: [related_return_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([product_id, occurred_at(sort: Desc)], map: "stock_movements_product_occurred_idx")
  @@index([variant_id, occurred_at(sort: Desc)], map: "stock_movements_variant_occurred_idx")
  @@index([occurred_at(sort: Desc)], map: "stock_movements_store_occurred_idx")
  @@index([related_order_id], map: "stock_movements_order_idx")
  @@index([related_hold_id], map: "stock_movements_hold_idx")
  @@schema("public")
}

model store_brand_assets {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset_id   String                @db.Uuid
  kind       cloudinary_asset_kind
  position   Int                   @default(0)
  created_at DateTime              @default(now()) @db.Timestamptz(6)

  cloudinary_assets cloudinary_assets @relation(fields: [asset_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([kind, position])
  @@schema("public")
}

model store_settings {
  id                    Int      @id @default(1)
  identity              Json     @default("{}")
  selling               Json     @default("{}")
  payments              Json     @default("{}")
  notifications         Json     @default("{}")
  updated_by_profile_id String?  @db.Uuid
  updated_at            DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  updated_by_profile profiles? @relation("store_settings_updater", fields: [updated_by_profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([updated_by_profile_id])
  @@schema("public")
}


generator client {
  provider        = "prisma-client"
  output          = "./generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.

model activity_events {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind             String
  title            String
  detail           String?
  actor_profile_id String?    @db.Uuid
  product_id       String?    @db.Uuid
  order_id         String?    @db.Uuid
  customer_id      String?    @db.Uuid
  occurred_at      DateTime   @default(now()) @db.Timestamptz(6)
  profiles         profiles?  @relation(fields: [actor_profile_id], references: [id], onUpdate: NoAction)
  customers        customers? @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  orders           orders?    @relation(fields: [order_id], references: [id], onUpdate: NoAction)
  products         products?  @relation(fields: [product_id], references: [id], onUpdate: NoAction)

  @@index([occurred_at(sort: Desc)], map: "activity_events_store_occurred_idx")
  @@schema("public")
}

model audit_events {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_profile_id String?   @db.Uuid
  action           String
  target_table     String?
  target_id        String?   @db.Uuid
  metadata         Json      @default("{}")
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  profiles         profiles? @relation(fields: [actor_profile_id], references: [id], onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "audit_events_store_created_idx")
  @@schema("public")
}

model catalogue_categories {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  slug       String
  image_url  String?
  position   Int        @default(0)
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @db.Timestamptz(6)
  products   products[]

  @@unique([slug])
  @@schema("public")
}

model catalogue_collections {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  slug       String
  position   Int        @default(0)
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  updated_at DateTime   @default(now()) @db.Timestamptz(6)
  products   products[]

  @@unique([slug])
  @@schema("public")
}

model cloudinary_assets {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider              String                @default("cloudinary")
  resource_type         String                @default("image")
  kind                  cloudinary_asset_kind
  public_id             String
  secure_url            String
  delivery_url          String?
  format                String?
  version               BigInt?
  width                 Int?
  height                Int?
  bytes                 Int?
  alt                   String                @default("")
  created_by_profile_id String?               @db.Uuid
  created_at            DateTime              @default(now()) @db.Timestamptz(6)
  profiles              profiles?             @relation(fields: [created_by_profile_id], references: [id], onUpdate: NoAction)
  product_media         product_media[]
  store_brand_assets    store_brand_assets[]

  @@unique([public_id])
  @@index([kind], map: "cloudinary_assets_store_kind_idx")
  @@schema("public")
}

model customer_addresses {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id    String    @db.Uuid
  label          String?
  line1          String
  line2          String?
  city           String
  state          String?
  country        String    @default("Nigeria")
  is_default     Boolean   @default(false)
  delivery_notes String?
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)
  customers      customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model customer_notes {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id       String    @db.Uuid
  body              String
  author_profile_id String?   @db.Uuid
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  profiles          profiles? @relation(fields: [author_profile_id], references: [id], onUpdate: NoAction)
  customers         customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customer_id], map: "customer_notes_store_customer_idx")
  @@schema("public")
}

model customer_saved_products {
  customer_id String    @db.Uuid
  product_id  String    @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products    products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([customer_id, product_id])
  @@schema("public")
}

model customers {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id              String?                   @db.Uuid
  name                    String
  email                   String?
  phone                   String?
  city                    String?
  type                    String                    @default("individual")
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @default(now()) @db.Timestamptz(6)
  activity_events         activity_events[]
  customer_addresses      customer_addresses[]
  customer_notes          customer_notes[]
  customer_saved_products customer_saved_products[]
  profiles                profiles?                 @relation(fields: [profile_id], references: [id], onUpdate: NoAction)
  holds                   holds[]
  orders                  orders[]
  product_reviews         product_reviews[]
  returns                 returns[]

  @@index([profile_id], map: "customers_profile_idx")
  @@index([email], map: "customers_store_email_idx")
  @@schema("public")
}

model delivery_zones {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  city           String
  rate           Decimal  @default(0) @db.Decimal(12, 2)
  estimated_days String?
  enabled        Boolean  @default(true)
  position       Int      @default(0)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

model holds {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id        String            @db.Uuid
  product_id         String            @db.Uuid
  variant_id         String?           @db.Uuid
  quantity           Int
  stage              String            @default("product")
  source             String
  payment_progress   String?
  status             String            @default("active")
  started_at         DateTime          @default(now()) @db.Timestamptz(6)
  expires_at         DateTime          @db.Timestamptz(6)
  released_at        DateTime?         @db.Timestamptz(6)
  converted_order_id String?           @db.Uuid
  note               String?
  customers          customers         @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products           products          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants   product_variants? @relation(fields: [variant_id], references: [id], onUpdate: NoAction)

  @@index([customer_id, status], map: "holds_customer_status_idx")
  @@index([status, expires_at], map: "holds_store_status_expires_idx")
  @@schema("public")
}

model intake_records {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id          String    @db.Uuid
  stage               String    @default("received")
  assigned_profile_id String?   @db.Uuid
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)
  profiles            profiles? @relation(fields: [assigned_profile_id], references: [id], onUpdate: NoAction)
  products            products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([stage], map: "intake_records_store_stage_idx")
  @@schema("public")
}

model order_lines {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id         String            @db.Uuid
  product_id       String            @db.Uuid
  variant_id       String?           @db.Uuid
  quantity         Int
  unit_price       Decimal           @db.Decimal(12, 2)
  stock_state      String            @default("uncommitted")
  orders           orders            @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products         products          @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  return_lines     return_lines[]

  @@schema("public")
}

model order_payment_events {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id         String    @db.Uuid
  payment_status   String
  amount           Decimal   @default(0) @db.Decimal(12, 2)
  method           String?
  occurred_at      DateTime  @default(now()) @db.Timestamptz(6)
  actor_profile_id String?   @db.Uuid
  note             String?
  profiles         profiles? @relation(fields: [actor_profile_id], references: [id], onUpdate: NoAction)
  orders           orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id, occurred_at(sort: Desc)], map: "order_payment_events_order_occurred_idx")
  @@schema("public")
}

model order_timeline_events {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id         String    @db.Uuid
  status           String
  occurred_at      DateTime  @default(now()) @db.Timestamptz(6)
  actor_profile_id String?   @db.Uuid
  note             String?
  profiles         profiles? @relation(fields: [actor_profile_id], references: [id], onUpdate: NoAction)
  orders           orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id, occurred_at(sort: Desc)], map: "order_timeline_events_order_occurred_idx")
  @@schema("public")
}

model orders {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id           String                  @db.Uuid
  source                String
  channel               String?
  payment_status        String                  @default("pending")
  payment_method        String?
  fulfilment_status     String                  @default("unfulfilled")
  total                 Decimal                 @db.Decimal(12, 2)
  refunded_amount       Decimal                 @default(0) @db.Decimal(12, 2)
  placed_at             DateTime                @default(now()) @db.Timestamptz(6)
  delivery_city         String?
  delivery_address      Json?
  courier               Json?
  notes                 String?
  attention             String?
  created_by_profile_id String?                 @db.Uuid
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  activity_events       activity_events[]
  order_lines           order_lines[]
  order_payment_events  order_payment_events[]
  order_timeline_events order_timeline_events[]
  profiles              profiles?               @relation(fields: [created_by_profile_id], references: [id], onUpdate: NoAction)
  customers             customers               @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  returns               returns[]

  @@index([customer_id, placed_at(sort: Desc)], map: "orders_customer_placed_idx")
  @@index([placed_at(sort: Desc)], map: "orders_store_placed_idx")
  @@schema("public")
}

model pickup_locations {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  address    String
  enabled    Boolean  @default(true)
  position   Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

model product_channels {
  product_id String          @db.Uuid
  channel    product_channel
  created_at DateTime        @default(now()) @db.Timestamptz(6)
  products   products        @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([product_id, channel])
  @@index([channel])
  @@schema("public")
}

model product_measurements {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String   @db.Uuid
  label      String
  value      String
  position   Int      @default(0)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model product_media {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id        String                @db.Uuid
  variant_id        String?               @db.Uuid
  asset_id          String                @db.Uuid
  kind              cloudinary_asset_kind
  position          Int                   @default(0)
  created_at        DateTime              @default(now()) @db.Timestamptz(6)
  cloudinary_assets cloudinary_assets     @relation(fields: [asset_id], references: [id], onUpdate: NoAction)
  products          products              @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants  product_variants?     @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([product_id, position])
  @@index([product_id, position], map: "product_media_product_position_idx")
  @@schema("public")
}

model product_reviews {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id  String    @db.Uuid
  customer_id String    @db.Uuid
  rating      Int
  title       String?
  body        String?
  status      String    @default("pending")
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  customers   customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products    products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customer_id], map: "product_reviews_customer_idx")
  @@index([product_id, status], map: "product_reviews_product_status_idx")
  @@schema("public")
}

model product_variants {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id      String            @db.Uuid
  label           String
  sku             String?
  size            String?
  colour          String?
  price           Decimal?          @db.Decimal(12, 2)
  cost            Decimal?          @db.Decimal(12, 2)
  position        Int               @default(0)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  holds           holds[]
  order_lines     order_lines[]
  product_media   product_media[]
  products        products          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  return_lines    return_lines[]
  stock_levels    stock_levels[]
  stock_movements stock_movements[]

  @@unique([product_id, sku], map: "product_variants_product_sku_unique", where: raw("(sku IS NOT NULL)"))
  @@schema("public")
}

model products {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id             String?                   @db.Uuid
  collection_id           String?                   @db.Uuid
  slug                    String
  name                    String
  description             String                    @default("")
  inventory_mode          product_inventory_mode
  brand                   String?
  price                   Decimal                   @db.Decimal(12, 2)
  reference_price         Decimal?                  @db.Decimal(12, 2)
  cost                    Decimal?                  @db.Decimal(12, 2)
  lifecycle               product_lifecycle         @default(draft)
  publication             product_publication       @default(unpublished)
  low_stock_threshold     Int                       @default(1)
  archive_number          String?
  sku                     String?
  condition               String?
  size_label              String?
  colour                  String?
  material                String?
  fit                     String?
  style                   String?
  care_instructions       String?
  flaw_notes              String?
  weight_grams            Int?
  pickup_available        Boolean                   @default(true)
  delivery_restrictions   String                    @default("")
  packaging_notes         String                    @default("")
  scheduled_at            DateTime?                 @db.Timestamptz(6)
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @default(now()) @db.Timestamptz(6)
  activity_events         activity_events[]
  customer_saved_products customer_saved_products[]
  holds                   holds[]
  intake_records          intake_records[]
  order_lines             order_lines[]
  product_channels        product_channels[]
  product_measurements    product_measurements[]
  product_media           product_media[]
  product_reviews         product_reviews[]
  product_variants        product_variants[]
  catalogue_categories    catalogue_categories?     @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  catalogue_collections   catalogue_collections?    @relation(fields: [collection_id], references: [id], onUpdate: NoAction)
  return_lines            return_lines[]
  stock_levels            stock_levels[]
  stock_movements         stock_movements[]

  @@unique([archive_number], map: "products_store_archive_number_unique", where: raw("(archive_number IS NOT NULL)"))
  @@unique([slug])
  @@unique([sku], map: "products_store_sku_unique", where: raw("(sku IS NOT NULL)"))
  @@index([inventory_mode], map: "products_store_inventory_mode_idx")
  @@index([lifecycle, publication], map: "products_store_lifecycle_publication_idx")
  @@schema("public")
}

model profiles {
  id                          String                  @id @db.Uuid
  email                       String?
  role                        account_role            @default(consumer)
  display_name                String?
  phone                       String?
  avatar_cloudinary_public_id String?
  avatar_url                  String?
  created_at                  DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime                @default(now()) @db.Timestamptz(6)
  activity_events             activity_events[]
  audit_events                audit_events[]
  cloudinary_assets           cloudinary_assets[]
  customer_notes              customer_notes[]
  customers                   customers[]
  intake_records              intake_records[]
  order_payment_events        order_payment_events[]
  order_timeline_events       order_timeline_events[]
  orders                      orders[]
  stock_movements             stock_movements[]

  @@unique([role], map: "profiles_single_admin_unique", where: raw("(role = 'admin'::account_role)"))
  @@schema("public")
}

model return_lines {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  return_id        String            @db.Uuid
  order_line_id    String            @db.Uuid
  product_id       String            @db.Uuid
  variant_id       String?           @db.Uuid
  quantity         Int
  disposition      String            @default("pending")
  order_lines      order_lines       @relation(fields: [order_line_id], references: [id], onUpdate: NoAction)
  products         products          @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  returns          returns           @relation(fields: [return_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@schema("public")
}

model returns {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id      String         @db.Uuid
  customer_id   String         @db.Uuid
  status        String         @default("requested")
  reason        String?
  refund_amount Decimal        @default(0) @db.Decimal(12, 2)
  note          String?
  requested_at  DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @default(now()) @db.Timestamptz(6)
  return_lines  return_lines[]
  customers     customers      @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  orders        orders         @relation(fields: [order_id], references: [id], onUpdate: NoAction)

  @@index([status], map: "returns_store_status_idx")
  @@schema("public")
}

model stock_levels {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id       String            @db.Uuid
  variant_id       String?           @db.Uuid
  total_received   Int               @default(0)
  available        Int               @default(0)
  reserved         Int               @default(0)
  sold             Int               @default(0)
  returned         Int               @default(0)
  damaged          Int               @default(0)
  updated_at       DateTime          @default(now()) @db.Timestamptz(6)
  products         products          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([available], map: "stock_levels_store_available_idx")
  @@schema("public")
}

model stock_movements {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id        String            @db.Uuid
  variant_id        String?           @db.Uuid
  kind              String
  quantity          Int
  occurred_at       DateTime          @default(now()) @db.Timestamptz(6)
  actor_profile_id  String?           @db.Uuid
  note              String?
  related_order_id  String?           @db.Uuid
  related_hold_id   String?           @db.Uuid
  related_return_id String?           @db.Uuid
  profiles          profiles?         @relation(fields: [actor_profile_id], references: [id], onUpdate: NoAction)
  products          products          @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  product_variants  product_variants? @relation(fields: [variant_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([product_id, occurred_at(sort: Desc)], map: "stock_movements_product_occurred_idx")
  @@index([occurred_at(sort: Desc)], map: "stock_movements_store_occurred_idx")
  @@schema("public")
}

model store_brand_assets {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asset_id          String                @db.Uuid
  kind              cloudinary_asset_kind
  position          Int                   @default(0)
  created_at        DateTime              @default(now()) @db.Timestamptz(6)
  cloudinary_assets cloudinary_assets     @relation(fields: [asset_id], references: [id], onUpdate: NoAction)

  @@unique([kind, position])
  @@schema("public")
}

model store_settings {
  id            Int      @id @default(1)
  identity      Json     @default("{}")
  selling       Json     @default("{}")
  payments      Json     @default("{}")
  notifications Json     @default("{}")
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

enum cloudinary_asset_kind {
  product_cover  @map("product-cover")
  product_detail @map("product-detail")
  product_defect @map("product-defect")
  store_logo     @map("store-logo")
  store_brand    @map("store-brand")

  @@schema("public")
}

enum product_channel {
  storefront
  physical_store @map("physical-store")
  whatsapp
  instagram

  @@schema("public")
}

enum product_inventory_mode {
  unique
  stocked
  variant

  @@schema("public")
}

enum product_lifecycle {
  draft
  intake
  active
  archived

  @@schema("public")
}

enum product_publication {
  published
  unpublished
  scheduled

  @@schema("public")
}

enum account_role {
  consumer
  admin
  manager

  @@schema("public")
}

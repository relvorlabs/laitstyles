/// An owner-approved destination for manual transfers. The raw account number
/// is encrypted at rest and never projected to clients or logs. The keyed
/// fingerprint supports deterministic duplicate detection without exposing the
/// account number.
model payout_recipients {
  id                        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider                  payment_provider @default(paystack)
  recipient_code            String
  recipient_type            String
  name                      String
  account_name              String?
  bank_name                 String?
  bank_code                 String?
  account_number_last4      String?
  account_number_ciphertext String?
  account_fingerprint       String?
  currency                  String           @default("NGN") @db.VarChar(3)
  is_active                 Boolean          @default(true)
  deleted_at                DateTime?        @db.Timestamptz(6)
  provider_snapshot         Json             @default("{}")
  created_by_profile_id     String?          @db.Uuid
  created_at                DateTime         @default(now()) @db.Timestamptz(6)
  updated_at                DateTime         @default(now()) @updatedAt @db.Timestamptz(6)

  profiles         profiles?          @relation(fields: [created_by_profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  payout_transfers payout_transfers[]

  @@unique([provider, recipient_code], map: "payout_recipients_provider_code_unique")
  @@unique([provider, currency, bank_code, account_fingerprint], map: "payout_recipients_account_fingerprint_unique", where: raw("(account_fingerprint IS NOT NULL AND deleted_at IS NULL)"))
  @@index([is_active, deleted_at], map: "payout_recipients_active_idx")
  @@schema("public")
}

/// A single owner-initiated transfer of store balance to a payout recipient.
/// The local intent, exact provider reference and idempotency key are persisted
/// before the provider call. Ambiguous provider responses remain explicitly
/// reconcilable and are never retried with a new reference.
model payout_transfers {
  id                      String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipient_id            String                 @db.Uuid
  provider                payment_provider       @default(paystack)
  reference               String
  provider_transfer_code  String?
  provider_status         String?
  idempotency_key         String?
  request_hash            String?
  amount                  Decimal                @db.Decimal(12, 2)
  currency                String                 @default("NGN") @db.VarChar(3)
  reason                  String?
  status                  payout_transfer_status @default(pending)
  otp_required            Boolean                @default(false)
  otp_attempts             Int                    @default(0)
  reconciliation_required Boolean                @default(false)
  failure_reason          String?
  provider_response       Json                   @default("{}")
  initiated_by_profile_id String?                @db.Uuid
  initiated_at            DateTime               @default(now()) @db.Timestamptz(6)
  last_otp_sent_at        DateTime?              @db.Timestamptz(6)
  last_provider_sync_at   DateTime?              @db.Timestamptz(6)
  completed_at            DateTime?              @db.Timestamptz(6)
  created_at              DateTime               @default(now()) @db.Timestamptz(6)
  updated_at              DateTime               @default(now()) @updatedAt @db.Timestamptz(6)

  payout_recipients               payout_recipients                 @relation(fields: [recipient_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  profiles                        profiles?                         @relation(fields: [initiated_by_profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  payout_transfer_events          payout_transfer_events[]
  settlement_transaction_mappings settlement_transaction_mappings[]

  @@unique([provider, reference], map: "payout_transfers_provider_reference_unique")
  @@unique([provider, provider_transfer_code], map: "payout_transfers_provider_code_unique", where: raw("(provider_transfer_code IS NOT NULL)"))
  @@unique([provider, idempotency_key], map: "payout_transfers_provider_idempotency_unique", where: raw("(idempotency_key IS NOT NULL)"))
  @@index([recipient_id], map: "payout_transfers_recipient_idx")
  @@index([status, updated_at], map: "payout_transfers_status_updated_idx")
  @@index([reconciliation_required, updated_at], map: "payout_transfers_reconciliation_idx")
  @@schema("public")
}

/// Append-only transfer history. Provider event IDs are unique so signed event
/// replay cannot apply a financial transition twice.
model payout_transfer_events {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transfer_id       String                     @db.Uuid
  kind              payout_transfer_event_kind
  status            payout_transfer_status?
  provider_event_id String?
  occurred_at       DateTime                   @default(now()) @db.Timestamptz(6)
  actor_profile_id  String?                    @db.Uuid
  note              String?
  metadata          Json                       @default("{}")
  provider_snapshot Json                       @default("{}")

  payout_transfers payout_transfers @relation(fields: [transfer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles         profiles?        @relation(fields: [actor_profile_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([provider_event_id], map: "payout_transfer_events_provider_event_unique", where: raw("(provider_event_id IS NOT NULL)"))
  @@index([transfer_id, occurred_at(sort: Desc)], map: "payout_transfer_events_transfer_occurred_idx")
  @@schema("public")
}

/// Read-only reconciliation of a provider settlement/payout of the store's
/// captured balance to its configured bank account.
model provider_settlements {
  id                              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider                        payment_provider  @default(paystack)
  provider_settlement_id          String
  status                          settlement_status @default(pending)
  total_amount                    Decimal           @db.Decimal(12, 2)
  effective_amount                Decimal           @default(0) @db.Decimal(12, 2)
  total_fees                      Decimal           @default(0) @db.Decimal(12, 2)
  total_processed                 Decimal           @default(0) @db.Decimal(12, 2)
  currency                        String            @default("NGN") @db.VarChar(3)
  settlement_account_name         String?
  settlement_account_number_last4 String?
  provider_snapshot               Json              @default("{}")
  last_provider_sync_at           DateTime?         @db.Timestamptz(6)
  settled_at                      DateTime?         @db.Timestamptz(6)
  created_at                      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime          @default(now()) @updatedAt @db.Timestamptz(6)

  settlement_transaction_mappings settlement_transaction_mappings[]

  @@unique([provider, provider_settlement_id], map: "provider_settlements_provider_id_unique")
  @@index([status, settled_at], map: "provider_settlements_status_settled_idx")
  @@schema("public")
}

/// Maps one provider settlement to an individual captured payment or outgoing
/// transfer. Provider transaction identifiers make reconciliation idempotent.
model settlement_transaction_mappings {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settlement_id           String   @db.Uuid
  payment_id              String?  @db.Uuid
  transfer_id             String?  @db.Uuid
  provider_transaction_id String?
  provider_reference      String?
  amount                  Decimal  @db.Decimal(12, 2)
  fee                     Decimal  @default(0) @db.Decimal(12, 2)
  created_at              DateTime @default(now()) @db.Timestamptz(6)

  provider_settlements provider_settlements @relation(fields: [settlement_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payments             payments?            @relation(fields: [payment_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  payout_transfers     payout_transfers?    @relation(fields: [transfer_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([settlement_id, provider_transaction_id], map: "settlement_transaction_provider_unique", where: raw("(provider_transaction_id IS NOT NULL)"))
  @@index([settlement_id], map: "settlement_transaction_mappings_settlement_idx")
  @@index([payment_id], map: "settlement_transaction_mappings_payment_idx")
  @@index([transfer_id], map: "settlement_transaction_mappings_transfer_idx")
  @@index([provider_reference], map: "settlement_transaction_reference_idx")
  @@schema("public")
}

/// Non-critical follow-up (receipts, notifications, reconciliation fan-out)
/// queued alongside a financial state transition so the transition itself
/// never blocks on a downstream side effect.
model outbox_messages {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topic        String
  payload      Json
  status       outbox_message_status @default(pending)
  attempts     Int                   @default(0)
  last_error   String?
  available_at DateTime              @default(now()) @db.Timestamptz(6)
  sent_at      DateTime?             @db.Timestamptz(6)
  created_at   DateTime              @default(now()) @db.Timestamptz(6)
  updated_at   DateTime              @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([status, available_at], map: "outbox_messages_status_available_idx")
  @@schema("public")
}

enum payout_transfer_status {
  pending
  otp_required
  processing
  needs_reconciliation
  success
  failed
  reversed

  @@schema("public")
}

enum payout_transfer_event_kind {
  initiated
  otp_requested
  otp_verified
  reconciliation_requested
  success
  failed
  reversed
  note

  @@schema("public")
}

enum settlement_status {
  pending
  processing
  success
  failed

  @@schema("public")
}

enum outbox_message_status {
  pending
  processing
  sent
  failed

  @@schema("public")
}

/// Append-only consent history. A new row is written only when a consent
/// value actually changes (enforced by the domain command layer), so the
/// latest row per (customer_id, consent_key) is the current decision.
model privacy_consents {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id    String              @db.Uuid
  consent_key    privacy_consent_key
  granted        Boolean
  policy_version String
  effective_at   DateTime            @default(now()) @db.Timestamptz(6)
  created_at     DateTime            @default(now()) @db.Timestamptz(6)

  customers customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customer_id, consent_key, effective_at(sort: Desc)], map: "privacy_consents_customer_key_effective_idx")
  @@schema("public")
}

/// One export job per request. `expires_at` is set once the export becomes
/// ready and must be after `created_at`. `storage_key` is an opaque pointer to
/// the generated artifact, never the artifact content itself.
model data_export_jobs {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id  String             @db.Uuid
  status       data_export_status @default(queued)
  storage_key  String?
  error        String?
  requested_at DateTime           @default(now()) @db.Timestamptz(6)
  completed_at DateTime?          @db.Timestamptz(6)
  expires_at   DateTime?          @db.Timestamptz(6)
  created_at   DateTime           @default(now()) @db.Timestamptz(6)
  updated_at   DateTime           @default(now()) @updatedAt @db.Timestamptz(6)

  customers customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customer_id, created_at(sort: Desc)], map: "data_export_jobs_customer_created_idx")
  @@index([status, expires_at], map: "data_export_jobs_status_expires_idx")
  @@schema("public")
}

/// At most one active (non-terminal) deletion request per customer, enforced
/// by a partial unique index in the migration SQL. `scheduled_for` is set to
/// `requested_at + 14 days`; cancellation is allowed before execution.
model account_deletion_requests {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id   String                  @db.Uuid
  status        account_deletion_status @default(requested)
  reason        String?
  requested_at  DateTime                @default(now()) @db.Timestamptz(6)
  scheduled_for DateTime?               @db.Timestamptz(6)
  cancelled_at  DateTime?               @db.Timestamptz(6)
  completed_at  DateTime?               @db.Timestamptz(6)
  created_at    DateTime                @default(now()) @db.Timestamptz(6)
  updated_at    DateTime                @default(now()) @updatedAt @db.Timestamptz(6)

  customers customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customer_id, created_at(sort: Desc)], map: "account_deletion_requests_customer_created_idx")
  @@index([status, scheduled_for], map: "account_deletion_requests_status_scheduled_idx")
  @@schema("public")
}

enum privacy_consent_key {
  analytics
  personalization
  marketing_email
  marketing_sms

  @@schema("public")
}

enum data_export_status {
  queued
  processing
  ready
  failed
  expired

  @@schema("public")
}

enum account_deletion_status {
  requested
  blocked
  cancelled
  scheduled
  completed

  @@schema("public")
}

/// Customer-owned display/contact defaults. One row per customer; created on
/// first write. Deterministic application-level defaults apply when absent.
model customer_preferences {
  customer_id             String             @id @db.Uuid
  contact_channel         contact_channel    @default(email)
  sizing_unit             sizing_unit_system @default(metric)
  marketing_opt_in        Boolean            @default(false)
  personalization_enabled Boolean            @default(true)
  created_at              DateTime           @default(now()) @db.Timestamptz(6)
  updated_at              DateTime           @default(now()) @updatedAt @db.Timestamptz(6)

  customers customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

/// Per-customer, per-category channel toggles. Required transactional/security
/// notices cannot be disabled from stored preferences (enforced by the domain
/// command layer and by the security-category check constraint below).
model notification_preferences {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id   String                @db.Uuid
  category      notification_category
  email_enabled Boolean               @default(true)
  sms_enabled   Boolean               @default(false)
  push_enabled  Boolean               @default(true)
  created_at    DateTime              @default(now()) @db.Timestamptz(6)
  updated_at    DateTime              @default(now()) @updatedAt @db.Timestamptz(6)

  customers customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([customer_id, category], map: "notification_preferences_customer_category_unique")
  @@schema("public")
}

/// Delivered customer notification feed. `event_key` de-duplicates repeated
/// outbox projection attempts; `data` is bounded, non-authorizing context only.
model notifications {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id String                @db.Uuid
  category    notification_category
  title       String
  body        String?
  data        Json                  @default("{}")
  event_key   String?
  read_at     DateTime?             @db.Timestamptz(6)
  created_at  DateTime              @default(now()) @db.Timestamptz(6)

  customers customers @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([event_key], map: "notifications_event_key_unique", where: raw("(event_key IS NOT NULL)"))
  @@index([customer_id, created_at(sort: Desc)], map: "notifications_customer_created_idx")
  @@index([customer_id, read_at], map: "notifications_customer_unread_idx")
  @@schema("public")
}

enum contact_channel {
  email
  sms
  whatsapp
  none

  @@schema("public")
}

enum sizing_unit_system {
  metric
  imperial

  @@schema("public")
}

enum notification_category {
  order_updates
  promotions
  support
  security

  @@schema("public")
}

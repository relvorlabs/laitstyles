{
  "name": "laitstyle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": "25.x"
  },
  "scripts": {
    "dev": "portless run next dev",
    "postinstall": "pnpm prisma:generate",
    "prebuild": "pnpm prisma:generate",
    "build": "next build",
    "start": "next start",
    "biome": "biome check .",
    "biome:fix": "biome check --write .",
    "lint": "pnpm biome",
    "lint:fix": "pnpm biome:fix",
    "format": "biome format --write .",
    "check": "pnpm biome:fix",
    "check:architecture": "node scripts/checks/architecture-guard.mjs && node scripts/checks/error-validation-contract.mjs && node scripts/checks/layout-provider-contract.mjs && node scripts/checks/http-module-contract.mjs",
    "audit:buttons": "node scripts/audit-buttons.mjs",
    "react-doctor": "pnpm dlx react-doctor@0.7.2 . --verbose --no-telemetry",
    "test:e2e": "playwright test",
    "test:unit": "pnpm test",
    "test:auth:e2e": "node scripts/auth/run-auth-e2e.mjs",
    "auth:local:setup": "node scripts/auth/setup-local-auth.mjs",
    "auth:local:stop": "supabase stop --no-backup",
    "ci:context": "node scripts/ci/collect-context.mjs",
    "ci:gates": "node scripts/ci/run-gates.mjs",
    "ci:http-smoke": "node scripts/ci/http-smoke.mjs",
    "ci:server-log": "node scripts/ci/check-server-log.mjs",
    "ci:merge-evidence": "node scripts/ci/merge-evidence.mjs",
    "ci:handoff": "node scripts/ci/build-agent-handoff.mjs",
    "ci:publish": "node scripts/ci/publish-feedback.mjs",
    "prisma:clean": "node scripts/db/clean-prisma-schema-input.mjs",
    "prisma:generate": "pnpm prisma:clean && prisma generate && pnpm prisma:clean",
    "prisma:format": "pnpm prisma:clean && prisma format",
    "prisma:validate": "pnpm prisma:clean && prisma validate",
    "prisma:studio": "pnpm prisma:clean && prisma studio",
    "prisma:migrate:dev": "pnpm prisma:clean && prisma migrate dev && pnpm prisma:generate",
    "prisma:migrate:deploy": "pnpm prisma:clean && prisma migrate deploy",
    "prisma:migrate:status": "pnpm prisma:clean && prisma migrate status",
    "prisma:migrate:diff": "pnpm prisma:clean && prisma migrate diff --from-config-datasource --to-schema prisma",
    "prisma:migrate:resolve": "pnpm prisma:clean && prisma migrate resolve",
    "prisma:migrate:reset": "pnpm prisma:clean && prisma migrate reset && pnpm prisma:generate",
    "prisma:pull": "pnpm prisma:clean && prisma db pull --print",
    "prisma:pull:write": "pnpm prisma:clean && node scripts/db/prisma-pull-write.mjs",
    "db:seed:storefront": "tsx scripts/seed/seed-storefront.ts",
    "db:import:catalog": "tsx scripts/seed/import-catalog-snapshot.ts",
    "smoke:storefront": "NODE_OPTIONS=--conditions=react-server tsx scripts/checks/storefront-smoke.ts",
    "test:styles:e2e": "node scripts/checks/non-admin-style-smoke.mjs",
    "typecheck": "tsc --noEmit --pretty false --incremental false",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "validate": "node scripts/ci/run-local-verification.mjs",
    "validate:fix": "node scripts/ci/run-local-verification.mjs --fix",
    "validate:full": "node scripts/ci/run-local-verification.mjs --full",
    "validate:browser": "node scripts/ci/run-local-verification.mjs --browser",
    "verify": "pnpm validate:full",
    "verify:local": "pnpm validate",
    "auth:bootstrap-admin": "tsx scripts/bootstrap-owner.mjs",
    "auth:create": "pnpm auth:bootstrap-admin --"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@paystack/inline-js": "^2.23.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "7.8.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "@tanstack/react-query": "^5.101.2",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "next-cloudinary": "^6.17.5",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "2.5.3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "prisma": "^7.8.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
